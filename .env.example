# ==============================================================================
# ŞANTİYE GO – ÇEVRESEL DEĞİŞKENLER (.env.example)
# ==============================================================================

# Site URL (Üretim ve SEO kanonik adresleri için)
NEXT_PUBLIC_SITE_URL=https://santiyego.vercel.app

# Supabase Proje Bilgileri (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo Veri Gösterme Ayarı (Canlıda gerçek veritabanı aktif olana kadar 'true' kalabilir)
NEXT_PUBLIC_SHOW_DEMO_DATA=true

# iyzico Ödeme Entegrasyonu (Test için sandbox anahtarları, canlıda iyzico panel anahtarları)
IYZICO_API_KEY=sandbox-apiKey-demo
IYZICO_SECRET_KEY=sandbox-secretKey-demo
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Opsiyonel: Hata İzleme (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=
