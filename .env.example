IYZICO_API_KEY=
IYZICO_BASE_URL=
IYZICO_SECRET_KEY=
# Yalnızca geliştirmede etkilidir; üretimde (NODE_ENV=production) Supabase bağlıyken demo verisi asla gösterilmez.
NEXT_PUBLIC_SHOW_DEMO_DATA=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CRON_SECRET=
ADMIN_2FA_SECRET=
# OTP jetonlarını imzalamak için en az 16 karakterlik rastgele gizli anahtar (yoksa SUPABASE_SERVICE_ROLE_KEY kullanılır).
OTP_SIGNING_SECRET=
# Üretimde siteyi iframe içine gömebilecek ek alan adları (varsayılan: yalnızca kendi sitesi). Örn: https://*.example.com 'self'
CSP_FRAME_ANCESTORS=

# --- Web Push (ücretsiz anlık bildirim) ---
# Anahtar üretmek için: npx web-push generate-vapid-keys   (public key -> NEXT_PUBLIC_VAPID_PUBLIC_KEY, private key -> VAPID_PRIVATE_KEY)
# NEXT_PUBLIC_* değerleri derleme sırasında gömülür: değiştirince yeniden deploy edin.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:destek@alanadiniz.com veya https://alanadiniz.com
VAPID_SUBJECT=
# Supabase Database Webhook gizli anahtarı (en az 16 karakter, rastgele).
# Supabase > Database > Webhooks > Create: Table=notifications, Events=Insert, Type=HTTP Request, Method=POST,
# URL=https://<alan-adiniz>/api/notifications/push-webhook, HTTP Header: Authorization = Bearer <bu değer>
PUSH_WEBHOOK_SECRET=

# --- Şirket Yasal Künye Bilgileri (6563 sayılı Kanun) ---
# Tanımlanmazsa Footer'daki künye alanı gizlenir (yer tutucu görünmez).
NEXT_PUBLIC_COMPANY_TITLE=
NEXT_PUBLIC_COMPANY_TAX_INFO=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_KEP=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Müşteri desteği (sağ alttaki "Yardım" düğmesi) ---
# Tanımlanmazsa ilgili satır gösterilmez. Örn: 0850 123 45 67 / 0532 123 45 67
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
